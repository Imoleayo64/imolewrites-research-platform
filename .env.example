GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=sqlite:///./imolewrites.db
SECRET_KEY=replace_with_a_long_random_secret_key

# Optional: real-time collaboration CRDT store (defaults to collab_store.db)
COLLAB_DB_PATH=collab_store.db

# Optional: S3-compatible file storage for PDF uploads (e.g. Cloudflare R2, free tier).
# Leave all four blank to use local disk storage instead (fine for dev, but many
# free hosting tiers wipe local disks on restart/redeploy).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: Mendeley reference-manager integration. Register a free app at
# https://dev.mendeley.com/myapps.html — set its Redirect URL to match
# MENDELEY_REDIRECT_URI below exactly.
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=http://127.0.0.1:8000/mendeley/callback

# The base URL of your frontend — used to redirect back here after Mendeley login.
FRONTEND_BASE_URL=http://127.0.0.1:5500/frontend

# Set this to your real deployed frontend URL once live (e.g.
# https://imolewrites-frontend.onrender.com) so the backend allows requests
# from it. Leave blank for local development.
EXTRA_CORS_ORIGIN=
